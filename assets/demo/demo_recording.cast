[0.018976, "o", "\u001b[2J\u001b[H\r\n"]
[0.519248, "o", "\r\n\u001b[38;5;245m\u001b[1m═══ Session 1: Team makes a decision, then changes it ═══\u001b[0m\r\n\r\n"]
[2.019405, "o", "\u001b[38;5;75m\u001b[1mUser:\u001b[0m Remember: we store the graph in Postgres.\r\n"]
[3.019583, "o", "\u001b[38;5;141mAgent: \u001b[2mthinking...\u001b[0m\r\n"]
[3.519516, "o", "\u001b[38;5;220m→ create_node(\u001b[2mowner_id='team_platform', node_type='Fact', text='We store the graph in Postgres'\u001b[38;5;220m)\u001b[0m\r\n"]
[4.820147, "o", "\u001b[38;5;120m  ✓ Created fact node (id: fact_postgres_001)\u001b[0m\r\n"]
[7.320328, "o", "\u001b[38;5;75m\u001b[1mUser:\u001b[0m We changed our mind: moving to ArcadeDB. Postgres is no longer used.\r\n"]
[8.320709, "o", "\u001b[38;5;141mAgent: \u001b[2mthinking...\u001b[0m\r\n"]
[8.820846, "o", "\u001b[38;5;220m→ mark_outdated(\u001b[2mowner_id='team_platform', node_id='fact_postgres_001', reason='Decision changed: migrating to ArcadeDB'\u001b[38;5;220m)\u001b[0m\r\n"]
[10.12119, "o", "\u001b[38;5;120m  ✓ Marked outdated (not deleted; stays in history)\u001b[0m\r\n"]
[11.921496, "o", "\u001b[38;5;220m→ create_node(\u001b[2mowner_id='team_platform', node_type='Fact', text='We store the graph in ArcadeDB'\u001b[38;5;220m)\u001b[0m\r\n"]
[13.221725, "o", "\u001b[38;5;120m  ✓ Created fact node (id: fact_arcadedb_001)\u001b[0m\r\n"]
[15.021842, "o", "\u001b[38;5;220m→ create_relation(\u001b[2mowner_id='team_platform', from_id='fact_arcadedb_001', to_id='fact_postgres_001', relation_type='CONTRADICTS'\u001b[38;5;220m)\u001b[0m\r\n"]
[16.322467, "o", "\u001b[38;5;120m  ✓ Created CONTRADICTS relation\u001b[0m\r\n"]
[18.822684, "o", "\u001b[38;5;75m\u001b[1mUser:\u001b[0m Note that our graph lives in ArcadeDB.\r\n"]
[19.822813, "o", "\u001b[38;5;141mAgent: \u001b[2mthinking...\u001b[0m\r\n"]
[20.323014, "o", "\u001b[38;5;220m→ create_node(\u001b[2mowner_id='team_platform', node_type='Fact', text='Our graph lives in ArcadeDB'\u001b[38;5;220m)\u001b[0m\r\n"]
[21.623206, "o", "\u001b[38;5;208m  ✓ ⚠ Refused: near-duplicate of fact_arcadedb_001 (similarity: 0.94)\u001b[0m\r\n"]
[22.623532, "o", "\u001b[2m  → No duplicates piling up\u001b[0m\r\n"]
[24.62371, "o", "\r\n\u001b[38;5;245m\u001b[1m═══ Next day — New session, empty context ═══\u001b[0m\r\n\r\n"]
[26.123842, "o", "\u001b[38;5;75m\u001b[1mUser:\u001b[0m Where do we store the graph?\r\n"]
[27.124012, "o", "\u001b[38;5;141mAgent: \u001b[2mthinking...\u001b[0m\r\n"]
[27.624096, "o", "\u001b[38;5;220m→ get_brief(\u001b[2mowner_id='team_platform'\u001b[38;5;220m)\u001b[0m\r\n"]
[28.924473, "o", "\u001b[38;5;120m  ✓ Retrieved: 1 active recent fact (Postgres fact omitted: outdated)\u001b[0m\r\n"]
[30.724831, "o", "\u001b[38;5;220m→ search(\u001b[2mowner_id='team_platform', query='where do we store the graph', compact=True, limit=3\u001b[38;5;220m)\u001b[0m\r\n"]
[32.325099, "o", "\r\n\u001b[38;5;120mSearch results (compact, under token budget):\u001b[0m\r\n\u001b[2m  1. We store the graph in ArcadeDB  [score: 0.89]\u001b[0m\r\n\u001b[2m     snippet: \"...graph in ArcadeDB\" (full text 6 tokens)\r\n\u001b[2m     status: active\u001b[0m\r\n\u001b[2m  \r\n\u001b[2m  Outdated/TTL facts hidden by default.\u001b[0m\r\n\u001b[2m  Old Postgres decision stays in history (mark_outdated), not deleted.\u001b[0m\r\n"]
[34.325575, "o", "\r\n\u001b[38;5;141mAgent:\u001b[0m Based on the current decision, we store the graph in ArcadeDB.\r\n"]
[36.325658, "o", "\r\n\u001b[38;5;245m\u001b[1m═══ Graph Memory MCP ═══\u001b[0m\r\n\r\n"]
[37.825989, "o", "\r\n\u001b[1mMemory for your team and its agents that doesn't turn into a dump\u001b[0m\r\n\r\n\u001b[2m  • The text in the graph is what the agent wrote\r\n  • Near-duplicates refused on write\r\n  • mark_outdated + CONTRADICTS keep history clean\r\n  • One owner_id = one physically isolated graph\r\n  • No LLM calls on the server (free, fast, offline)\u001b[0m\r\n\r\n\u001b[38;5;75mInstall:\u001b[0m\r\n  docker compose up -d && uv run graph-memory-mcp\r\n\r\n\u001b[2m  https://github.com/river-ai-lab/graph-memory-mcp\u001b[0m\r\n\r\n"]
